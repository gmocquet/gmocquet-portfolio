# Copy to .env (gitignored, auto-loaded by direnv via .envrc). Never commit real values.

# Cloudflare deploy — used by `make deploy` (wrangler) and the OpenTofu infra (infra/cloudflare).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# OpenTofu remote state — Cloudflare R2 (s3 backend). Create an R2 API token
# (Object Read & Write, scoped to the bucket) and paste its S3 keys here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Public Cloudflare Web Analytics beacon token (embedded in the page at build time; not a secret).
# Obtain it from `tofu output -raw web_analytics_token` after applying infra/cloudflare.
PUBLIC_CF_BEACON_TOKEN=

# Optional: Anthropic API key fallback for the i18n CLI (OAuth session is the default — see CLAUDE.md).
ANTHROPIC_API_KEY=
