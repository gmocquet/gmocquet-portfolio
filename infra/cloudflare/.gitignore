# OpenTofu provider cache — never committed (large binaries).
.terraform/
crash.log

# State lives in a remote backend (Cloudflare R2 — see backend.tf / ADR 0008), never in git.
# Ignore any local copy an init/migrate/pull may leave behind.
*.tfstate
*.tfstate.backup

# Real variable values — commit only the example.
*.tfvars
!*.tfvars.example
