---
import { ThemeToggle } from "@gmocquet/ui";
import { getCollection } from "astro:content";

const profile = (await getCollection("profile"))[0].data;
const path = Astro.url.pathname;
const links = [
  { href: "/projects", label: "Projects" },
  { href: "/about", label: "About" },
  { href: "/tags", label: "Tags" },
  { href: "/contact", label: "Contact" },
];
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="sticky top-0 z-50 border-b border-border bg-bg/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between px-6">
    <a href="/" class="font-display text-lg tracking-tight text-fg">Guillaume&nbsp;Mocquet</a>
    <nav class="flex items-center gap-1">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={[
              "px-3 py-2 text-sm transition-colors",
              isActive(l.href) ? "text-fg" : "text-muted hover:text-fg",
            ]}
          >
            {l.label}
          </a>
        ))
      }
      {
        profile.repository ? (
          <a
            href={profile.repository}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="View the source on GitHub (new tab)"
            class="px-3 py-2 text-muted transition-colors hover:text-fg"
          >
            <svg viewBox="0 0 16 16" class="size-5 fill-current" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
            </svg>
          </a>
        ) : null
      }
      <ThemeToggle client:load />
    </nav>
  </div>
</header>
