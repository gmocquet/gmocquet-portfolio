---
import { Badge } from "@gmocquet/ui";
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import ProjectMedia from "../../components/ProjectMedia.astro";
import Base from "../../layouts/Base.astro";

export const getStaticPaths = (async () => {
  const projects = await getCollection("projects");
  return projects.map((p) => ({ params: { id: p.id }, props: { project: p.data } }));
}) satisfies GetStaticPaths;

const { project: p } = Astro.props;
const meta = [p.company, p.period, p.role].filter(Boolean).join(" · ");
---

<Base title={`${p.title} — Guillaume Mocquet`} description={p.summary}>
  <article class="mx-auto max-w-3xl px-6 pt-20 pb-16">
    <a href="/projects" class="text-sm text-muted transition-colors hover:text-accent">← Projects</a>
    {meta ? <p class="mt-8 text-xs uppercase tracking-wider text-muted">{meta}</p> : null}
    <h1 class="mt-2 font-display text-4xl text-fg">{p.title}</h1>
    <p class="mt-6 text-lg leading-relaxed text-muted">{p.summary}</p>

    {
      p.outcomes.length > 0 ? (
        <ul class="mt-8 space-y-2">
          {p.outcomes.map((o) => (
            <li class="text-fg/85 before:mr-2 before:text-accent before:content-['▸']">{o}</li>
          ))}
        </ul>
      ) : null
    }

    {
      p.stack.length > 0 ? (
        <ul class="mt-8 flex flex-wrap gap-1.5">
          {p.stack.map((s) => (
            <li>
              <Badge>{s}</Badge>
            </li>
          ))}
        </ul>
      ) : null
    }

    <ProjectMedia media={p.media} />

    {
      (p.sections ?? []).length > 0 ? (
        <div class="mt-12 space-y-12">
          {(p.sections ?? []).map((s, i) => (
            <section>
              <h2 class="font-display text-2xl text-fg">{`${i + 1}. ${s.title}`}</h2>
              {s.body.map((paragraph) => (
                <p class="mt-3 leading-relaxed text-muted">{paragraph}</p>
              ))}
              {s.image ? (
                <img
                  src={s.image.src}
                  alt={s.image.alt}
                  loading="lazy"
                  class="mt-6 w-full rounded-lg border border-border"
                />
              ) : null}
              <ProjectMedia media={s.media} />
            </section>
          ))}
        </div>
      ) : null
    }
  </article>
</Base>
