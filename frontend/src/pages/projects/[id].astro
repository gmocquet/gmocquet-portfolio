---
import {
  Badge,
  MediaLinks,
  MediaTimecodes,
  PdfEmbed,
  VideoEmbed,
  partitionMedia,
  toEmbedUrl,
} from "@gmocquet/ui";
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

export const getStaticPaths = (async () => {
  const projects = await getCollection("projects");
  return projects.map((p) => ({ params: { id: p.id }, props: { project: p.data } }));
}) satisfies GetStaticPaths;

const { project: p } = Astro.props;
const meta = [p.company, p.period, p.role].filter(Boolean).join(" · ");

// Embeddable media (videos, opted-in PDFs) render as inline sections; the rest stays plain links.
const { sections, links } = partitionMedia(p.media);
---

<Base title={`${p.title} — Guillaume Mocquet`} description={p.summary}>
  <article class="mx-auto max-w-3xl px-6 pt-20 pb-16">
    <a href="/projects" class="text-sm text-muted transition-colors hover:text-accent">← Projects</a>
    {meta ? <p class="mt-8 text-xs uppercase tracking-wider text-muted">{meta}</p> : null}
    <h1 class="mt-2 font-display text-4xl text-fg">{p.title}</h1>
    <p class="mt-6 text-lg leading-relaxed text-muted">{p.summary}</p>

    {
      p.outcomes.length > 0 ? (
        <ul class="mt-8 space-y-2">
          {p.outcomes.map((o) => (
            <li class="text-fg/85 before:mr-2 before:text-accent before:content-['▸']">{o}</li>
          ))}
        </ul>
      ) : null
    }

    {
      p.stack.length > 0 ? (
        <ul class="mt-8 flex flex-wrap gap-1.5">
          {p.stack.map((s) => (
            <li>
              <Badge>{s}</Badge>
            </li>
          ))}
        </ul>
      ) : null
    }

    {
      sections.length > 0 ? (
        <div class="mt-10 space-y-10">
          {sections.map((m) => (
            <section>
              {m.description ? (
                <p class="mb-4 leading-relaxed text-muted">
                  {m.description}{" "}
                  {m.fullVersion ? (
                    <a
                      href={m.fullVersion.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-accent underline-offset-4 transition-colors hover:underline"
                    >
                      {m.fullVersion.label}
                    </a>
                  ) : null}
                </p>
              ) : null}
              {toEmbedUrl(m) !== null ? (
                <VideoEmbed media={m} />
              ) : (
                <PdfEmbed client:only="react" media={m} />
              )}
              <MediaTimecodes client:visible media={m} />
            </section>
          ))}
        </div>
      ) : null
    }

    {links.length > 0 ? <div class="mt-8"><MediaLinks media={links} /></div> : null}
  </article>
</Base>
