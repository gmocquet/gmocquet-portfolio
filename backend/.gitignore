# Python ecosystem ignores (OS/editor ignores live in the repo-root .gitignore).

# Byte-compiled / caches
__pycache__/
*.py[cod]
*$py.class

# Packaging / build
build/
dist/
*.egg-info/
.eggs/

# Virtual env (uv)
.venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Coverage
.coverage
.coverage.*
htmlcov/
coverage.xml
