# Root .gitignore — OS, editors, and local secrets only.
# Stack-specific ignores live in each ecosystem: frontend/.gitignore (Node), backend/.gitignore (Python).

# OS generated files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# IDEs and editors
.idea/
.vscode/
*.swp
*.swo
*~

# Local secrets / environment (loaded by direnv via .envrc).
# NOTE: .envrc itself IS committed (it contains no secrets).
.env
.env.*
!.env.example

# direnv runtime
.direnv/

# Logs / scratch
*.log

# wrangler local cache (created by `make deploy`)
.wrangler/

# Local scratch / source assets (never committed)
/tmp/
