# Root .gitignore — OS, editors, and local secrets only.
# Stack-specific ignores live in each ecosystem: frontend/.gitignore (Node), backend/.gitignore (Python).

# OS generated files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# IDEs and editors
.idea/
.vscode/
*.swp
*.swo
*~

# Local secrets / environment — generated by `make secrets-pull` from Infisical, loaded by direnv.
# NOTE: .envrc and .infisical.json ARE committed (no secrets — project id only); .env never is.
.env
.env.*

# direnv runtime
.direnv/

# Logs / scratch
*.log

# wrangler local cache (created by `make deploy`)
.wrangler/

# Local scratch / source assets (never committed)
/tmp/
